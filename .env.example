# Copy to .env.local and fill in. Variables starting with VITE_ end up in the
# browser bundle: never put secrets in them.

# ── Database and sign-in (Supabase) ──────────────────────────────────────────
# Without these, the app runs in local-development mode (.data/db.json, email-only sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase › Project Settings › API Keys › Secret keys
SUPABASE_SECRET_KEY=
# true once the Google provider is enabled in Supabase
VITE_AUTH_GOOGLE=false

# ── Messages (server only) ───────────────────────────────────────────────────
# Email through resend.com: an API key, and a sender address on a domain verified there.
RESEND_API_KEY=
MAIL_FROM=
# SMS through globalsms.co.il: the API key from your account, and the sender name customers see
# (up to 11 English letters/digits, approved by Global SMS, e.g. Tornu).
GLOBALSMS_API_KEY=
GLOBALSMS_SENDER=
# WhatsApp through Meta's Cloud API (one platform number for every business):
# a permanent System User token, and the IDs from WhatsApp Manager › API setup.
# The account ID is only needed to submit the templates: npm run whatsapp:templates
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any long random string; the same value goes in supabase/cron.sql, which sends due messages every 5 minutes.
CRON_SECRET=
# Development: MESSAGES_LOG=1 prints every message to the terminal instead of sending it.
# MESSAGES_LOG=1

# ── Product ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=

# ── Legal pages and help ─────────────────────────────────────────────────────
VITE_LEGAL_COMPANY=
VITE_LEGAL_COMPANY_ID=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_A11Y_CONTACT=

# ── Setup videos (YouTube / Vimeo links) ─────────────────────────────────────
VITE_VIDEO_WELCOME=
VITE_VIDEO_PAGE=
VITE_VIDEO_PHOTOS=
VITE_VIDEO_TEAM=
VITE_VIDEO_PUBLISH=
VITE_VIDEO_CALENDAR=
VITE_VIDEO_SHARE=

# ── Optional ─────────────────────────────────────────────────────────────────
# VITE_BACKEND=mock       in-browser demo, no server at all
