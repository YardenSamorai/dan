# Copy to .env.local and fill in. Variables starting with VITE_ end up in the
# browser bundle: never put secrets in them.

# ── Database and sign-in (Supabase) ──────────────────────────────────────────
# Without these, the app runs in local-development mode (.data/db.json, email-only sign-in).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase › Project Settings › API Keys › Secret keys
SUPABASE_SECRET_KEY=
# true once the Google provider is enabled in Supabase
VITE_AUTH_GOOGLE=false

# ── Product ──────────────────────────────────────────────────────────────────
VITE_APP_NAME=

# ── Legal pages and help ─────────────────────────────────────────────────────
VITE_LEGAL_COMPANY=
VITE_LEGAL_COMPANY_ID=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_A11Y_CONTACT=

# ── Setup videos (YouTube / Vimeo links) ─────────────────────────────────────
VITE_VIDEO_WELCOME=
VITE_VIDEO_PAGE=
VITE_VIDEO_PHOTOS=
VITE_VIDEO_TEAM=
VITE_VIDEO_PUBLISH=
VITE_VIDEO_CALENDAR=
VITE_VIDEO_SHARE=

# ── Optional ─────────────────────────────────────────────────────────────────
# VITE_BACKEND=mock       in-browser demo, no server at all
